# deploy/sudoers.d/aegis — the agent gets a narrow allowlist instead of unrestricted root.
Defaults:aegis secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Defaults:aegis !requiretty

Cmnd_Alias AEGIS_SYSTEMD = /usr/bin/systemctl *, /usr/bin/journalctl *
Cmnd_Alias AEGIS_FIREWALL = /usr/sbin/ufw *, /usr/sbin/nft *, /usr/sbin/iptables *, /usr/sbin/ip *, /usr/bin/wg *
Cmnd_Alias AEGIS_PACKAGES = /usr/bin/apt-get *, /usr/bin/apt *, /usr/bin/snap *, /usr/bin/flatpak *
Cmnd_Alias AEGIS_DOCKER = /usr/bin/docker *, /usr/bin/docker compose *
Cmnd_Alias AEGIS_WEB = /usr/bin/caddy validate *, /usr/bin/caddy reload *, /usr/bin/caddy adapt *
Cmnd_Alias AEGIS_BACKUPS = /usr/bin/restic *, /usr/bin/pg_dump *, /usr/bin/pg_restore *, /usr/bin/mysqldump *, /usr/bin/mysql *, /usr/bin/redis-cli *, /usr/local/bin/litestream *
Cmnd_Alias AEGIS_FILES = /usr/bin/chown *, /usr/bin/chmod *, /usr/bin/chattr *, /usr/bin/tar *, /usr/bin/zip *, /usr/bin/unzip *, /usr/bin/sha256sum *, /usr/bin/rg *

aegis ALL=(root) NOPASSWD: AEGIS_SYSTEMD, AEGIS_FIREWALL, AEGIS_PACKAGES, AEGIS_DOCKER, AEGIS_WEB, AEGIS_BACKUPS, AEGIS_FILES